{
  "name": "customer-service",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @cs/api db:generate",
    "db:migrate": "pnpm --filter @cs/api db:migrate",
    "db:push": "pnpm --filter @cs/api db:push",
    "graphify:update": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/graphify-update.ps1",
    "graphify:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/graphify-build.ps1"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2"
  }
}
