{
  "name": "@cs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:isolation": "tsx --test src/isolation.test.ts",
    "test:payments": "tsx --test src/payments.test.ts",
    "test:retrieve": "tsx --test src/retrieve.test.ts",
    "test:reminders": "tsx --test src/reminders.test.ts",
    "test:reminders": "tsx --test src/reminders.test.ts",
    "smoke": "tsx scripts/smoke-e2e.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cs/shared": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/websocket": "^11.1.0",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "sanka-baileyss": "^2.5.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.11.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
