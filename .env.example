# Database
DATABASE_URL=postgresql://cs:cs_secret@localhost:5432/customer_service
REDIS_URL=redis://localhost:6379

# Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
BETTER_AUTH_URL=http://localhost:3001
API_URL=http://localhost:4000
WEB_URL=http://localhost:3001
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# LLM (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://openagentic.id/api/v1
LLM_CHAT_MODEL=claude-sonnet-4.5
LLM_EMBED_MODEL=text-embedding-3-small

# Storage (local filesystem for dev; S3-compatible later)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# App
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3001
